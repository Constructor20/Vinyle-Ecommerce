<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml" fx:controller="com.vinylstore.controllers.AdminVinyleController" spacing="15" style="-fx-padding: 20; -fx-background-color: #f0f2f5;">

    <stylesheets><![CDATA[/css/style.css]]></stylesheets>

    <Label text="Gestion des vinyles" styleClass="titre-principal" />

    <Label fx:id="messageErreur" styleClass="label-erreur" visible="false" />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Ajouter" onAction="#ajouterVinyle" prefWidth="120" styleClass="btn-succes" />
        <Button text="Modifier" onAction="#modifierVinyle" prefWidth="120" styleClass="btn-primaire" />
        <Button text="Supprimer" onAction="#supprimerVinyle" prefWidth="120" styleClass="btn-danger" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Retour" onAction="#retourAdmin" prefWidth="120" styleClass="btn-secondaire" />
    </HBox>

    <TableView fx:id="tableauVinyles" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colonneId" text="ID" prefWidth="40" />
            <TableColumn fx:id="colonneTitre" text="Titre" prefWidth="200" />
            <TableColumn fx:id="colonneArtiste" text="Artiste" prefWidth="150" />
            <TableColumn fx:id="colonneGenre" text="Genre" prefWidth="100" />
            <TableColumn fx:id="colonneAnnee" text="Année" prefWidth="70" />
            <TableColumn fx:id="colonnePrix" text="Prix" prefWidth="80" />
            <TableColumn fx:id="colonneStock" text="Stock" prefWidth="60" />
        </columns>
    </TableView>

</VBox>
